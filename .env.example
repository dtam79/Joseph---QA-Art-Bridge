[TEMPLATE]
# ── App URLs ──────────────────────────────────────────────────────────────
# Local .env uses explicit main/staging pairs (the morning check and the app
# suites fall back to them). CI sets the canonical <APP>_URL secrets instead.
ART_BRIDGE_MAIN_URL=
ART_BRIDGE_STAGING_URL=
HOT_DEAL_MAIN_URL=
HOT_DEAL_STAGING_URL=
OH_GOOD_MAIN_URL=
OH_GOOD_STAGING_URL=
HANDS_MAIN_URL=
HANDS_STAGING_URL=

# ── Login credentials (morning-check "login works" checks) ────────────────
ART_BRIDGE_USER=
ART_BRIDGE_PASS=
HOT_DEAL_USER=
HOT_DEAL_EMAIL=   # email address for Hot Deal email-mode login (separate from HOT_DEAL_USER)
HOT_DEAL_PASS=
OH_GOOD_USER=
OH_GOOD_PASS=

# ── Password gates ────────────────────────────────────────────────────────
# Art-bridge site-wide password gate (required for art-bridge tests)
ART_BRIDGE_PASSWORD=
# Hot-deal site-wide password gate (optional — some specs skip the gate if unset)
HOT_DEAL_SITE_PASSWORD=

# ── Telegram (morning-check notification) ─────────────────────────────────
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Optional run settings
# RUN_MODE=emulator  # "emulator" (default, iPhone 13 emulation) or "browser" (desktop Chrome)
# BROWSER=chromium   # engine override: "chromium", "firefox" or "webkit" (unset = device-natural engine)

# Optional: boot an app locally with Playwright's webServer instead of its deployed URL.
# Set these per app (in CI they are set by the workflow after checking out the app repo):
#   ART_BRIDGE_WS_COMMAND=docker compose up -d --wait
#   ART_BRIDGE_WS_URL=http://localhost:3000
#   ART_BRIDGE_WS_CWD=../art-bridge
# Same pattern for HOT_DEAL_WS_* and OH_GOOD_WS_*. When <APP>_WS_COMMAND + <APP>_WS_URL
# are set, that project's baseURL points at the local server; otherwise it uses
# <APP>_URL, falling back to <APP>_STAGING_URL / <APP>_MAIN_URL.
